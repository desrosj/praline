<?xml version="1.0"?>
<ruleset name="Praline">
	<file>praline.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<arg name="extensions" value="php"/>
	<arg value="s"/>

	<!-- Requires PHP: 8.2 in praline.php. -->
	<config name="testVersion" value="8.2-"/>
	<rule ref="PHPCompatibilityWP"/>
	<!-- PHPCompatibility 9.3.5 predates enums and reads $this in an enum method as outside a class. -->
	<rule ref="PHPCompatibility.Variables.ForbiddenThisUseContexts.OutsideObjectContext">
		<exclude-pattern>src/Direction.php</exclude-pattern>
	</rule>

	<rule ref="WordPress">
		<!-- Classes are autoloaded PSR-4 style, as in Markdown Alternate. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="praline"/>
			</property>
		</properties>
	</rule>
</ruleset>
