<?xml version="1.0"?>
<ruleset name="Praline">
	<file>praline.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<arg name="extensions" value="php"/>
	<arg value="s"/>

	<rule ref="WordPress">
		<!-- Classes are autoloaded PSR-4 style, as in Markdown Alternate. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="praline"/>
			</property>
		</properties>
	</rule>
</ruleset>
