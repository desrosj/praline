{
    "name": "desrosj/praline",
    "description": "Serves WordPress posts and pages as Markdown for BonBon, the browser for the Markdown web.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "repositories": [
        { "type": "vcs", "url": "https://github.com/ProgressPlanner/markdown-alternate" }
    ],
    "require": {
        "php": ">=8.2",
        "joost/markdown-alternate": "1.2.0"
    },
    "replace": {
        "yahnis-elsts/plugin-update-checker": "*"
    },
    "require-dev": {
        "brianhenryie/strauss": "0.31.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.0",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.11",
        "wp-coding-standards/wpcs": "^3.0",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": false,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": { "php": "8.2" },
        "sort-packages": true
    },
    "extra": {
        "installer-paths": { "vendor/{$vendor}/{$name}": ["type:wordpress-plugin"] },
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "Praline\\Vendor\\",
            "classmap_prefix": "Praline_",
            "packages": ["joost/markdown-alternate"],
            "exclude_from_copy": {
                "packages": ["yahnis-elsts/plugin-update-checker"],
                "file_patterns": ["~markdown-alternate/(markdown-alternate\\.php|src/Plugin\\.php|src/Integration/|tests/)~"]
            },
            "delete_vendor_packages": false
        }
    },
    "scripts": {
        "prefix": ["strauss", "@php bin/mark-modified.php"],
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "phpcompat": "phpcs --standard=phpcompat.xml.dist",
        "test": "phpunit",
        "test:e2e": "tests/e2e/run.sh",
        "post-install-cmd": ["@prefix"],
        "post-update-cmd": ["@prefix"]
    }
}
